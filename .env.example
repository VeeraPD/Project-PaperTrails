# Copy this file to ".env" and fill in your values. Never commit ".env".

# Required: your Gemini API key
GEMINI_API_KEY=

# Optional: model used to write answers (default: gemini-3.8-flash)
# GEMINI_CHAT_MODEL=gemini-3.8-flash

# Required on Vercel only: Chroma Cloud credentials.
# Leave these blank locally and Chroma saves to ./chroma_data instead.
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# Optional, local only: where Chroma stores data (default: ./chroma_data)
# CHROMA_PATH=./chroma_data
